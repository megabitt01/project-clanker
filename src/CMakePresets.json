{
  "version": 6,
  "configurePresets": [
    {
      "name": "win32",
      "displayName": "Windows x86 (MSVC + vcpkg)",
      "generator": "Visual Studio 18 2026",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/../build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x86-windows-static"
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "win32", "configuration": "Release" },
    { "name": "debug", "configurePreset": "win32", "configuration": "Debug" }
  ]
}
